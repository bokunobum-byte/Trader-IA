# ═══════════════════════════════════════════════════════════════════════════
# Tarder IA — variáveis de ambiente (EXEMPLO)
# ═══════════════════════════════════════════════════════════════════════════
#
# 1) Copie este arquivo para ".env" (sem o ".example"):
#       cp .env.example .env        (Linux/macOS)
#       copy .env.example .env      (Windows CMD)
#       Copy-Item .env.example .env (Windows PowerShell)
#
# 2) Substitua o valor abaixo pela sua chave real da NVIDIA.
#    Obtenha em: https://build.nvidia.com  →  "API Keys"  →  "Generate API Key"
#
# 3) NUNCA faça commit do arquivo ".env" — o ".gitignore" já o bloqueia.
#    No Render, defina NVIDIA_API_KEY direto no dashboard (Environment Variables).
#
# ═══════════════════════════════════════════════════════════════════════════

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx